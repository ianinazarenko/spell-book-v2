generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpellStatus {
  QUEUED      // Создано/ждет запуска
  RUNNING     // В процессе выполнения
  COMPLETED   // Успешно завершено
  FAILED      // Завершилось с ошибкой
}

model SpellJob {
  id                  String        @id @default(cuid())
  spellText           String        @db.Text @map("spell_text")
  iterationsTotal     Int           @map("iterations_total")
  iterationsCompleted Int           @map("iterations_completed") @default(0)
  durationMin         Int           @map("duration_min") @default(60)
  status              SpellStatus   @default(QUEUED) 
  createdAt           DateTime      @map("created_at") @default(now())
  updatedAt           DateTime      @map("updated_at") @updatedAt 
  errorMessage        String?       @map("error_message") @db.Text

  @@map("spell_jobs")
}