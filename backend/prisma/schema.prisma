generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SpellStatus {
  QUEUED // Создано/ждет запуска
  RUNNING // В процессе выполнения
  COMPLETED // Успешно завершено
  FAILED // Завершилось с ошибкой
}

model SpellJob {
  id           String   @id @default(cuid())
  spellText    String   @map("spell_text") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  errorMessage String?  @map("error_message") @db.Text

  @@map("spell_jobs")
}

model SavedSpell {
  id        String @id @default(cuid())
  spellText String @map("spell_text") @db.Text

  @@map("saved_spells")
}

model SpellConfig {
  id                  String      @id @default("spell-configs")
  durationMin         Int?        @map("duration_min")
  iterationsTotal     Int         @default(1770) @map("iterations_total")
  iterationsCompleted Int         @default(0) @map("iterations_completed")
  status              SpellStatus @default(QUEUED)
  runId               String?     @default(uuid()) @map("run_id") @db.Uuid

  @@map("spell_configs")
}
